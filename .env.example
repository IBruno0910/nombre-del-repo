# Server-only. Never use a VITE_ prefix for credentials.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contact@openworldaviation.com
# Google app password if allowed by the account administrator. Not the normal password.
SMTP_PASS=
MAIL_FROM="Open World Aviation <contact@openworldaviation.com>"
# Required in production: exact public origin, no trailing slash.
SITE_ORIGIN=
SEND_AUTOREPLY=true
# Optional alternative: set MAIL_TRANSPORT=resend and provide a verified sender.
RESEND_API_KEY=
